# 部署环境变量样例：复制为 deploy/.env 后按需修改（.env 不入库）
# MySQL root 密码（容器初始化与后端连接共用）
MYSQL_PASSWORD=please-change-me
# 站点对外访问地址（RSS / sitemap 里的链接前缀）
SITE_URL=http://localhost
# ---- 邮件服务（v2.0）：不配置则退化为日志模拟发信 ----
MAIL_TYPE=smtp
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your@qq.com
MAIL_PASSWORD=your-smtp-auth-code
MAIL_FROM=your@qq.com
# ---- GitHub OAuth 登录（v2.1）：不配置则登录页 GitHub 入口不可用 ----
# OAuth App 的 Authorization callback URL 填 http://localhost/auth/github（前台落地路由）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost/auth/github
